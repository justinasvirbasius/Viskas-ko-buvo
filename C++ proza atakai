struct LearningDecree {
    double learningRate = 0.001;
    double gradientLimit = 1.0;
    double lossThreshold = 0.01;

    bool trainingEnabled = false;
};

class LearningGovernor {
private:
    LearningDecree decree;

public:
    void configure(const LearningDecree& newDecree) {
        if (!std::isfinite(newDecree.learningRate) ||
            newDecree.learningRate <= 0.0 ||
            !std::isfinite(newDecree.gradientLimit) ||
            newDecree.gradientLimit <= 0.0 ||
            !std::isfinite(newDecree.lossThreshold) ||
            newDecree.lossThreshold < 0.0) {
            throw std::invalid_argument(
                "Invalid learning decree");
        }

        decree = newDecree;
    }

    bool authorizeTraining(double loss) const {
        return decree.trainingEnabled &&
               std::isfinite(loss) &&
               loss > decree.lossThreshold;
    }

    double regulateGradient(double gradient) const {
        if (!std::isfinite(gradient))
            throw std::invalid_argument(
                "Non-finite gradient");

        return std::clamp(
            gradient,
            -decree.gradientLimit,
            decree.gradientLimit
        );
    }
};
