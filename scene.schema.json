{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDF Prepackager Rechts Scene",
  "type": "object",
  "required": ["bounds_min", "bounds_max", "primitives"],
  "properties": {
    "bounds_min": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "bounds_max": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "resolution": {"type": "array", "items": {"type": "integer"}, "minItems": 3, "maxItems": 3},
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    }
  }
}
