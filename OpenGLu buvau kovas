for (const DrawBatch& batch : batches)
{
    BindPipeline(batch.pipeline);

    glMultiDrawElementsIndirect(
        GL_TRIANGLES,
        GL_UNSIGNED_INT,
        commandOffset +
            batch.firstCommand *
            sizeof(DrawElementsIndirectCommand),
        batch.commandCount,
        sizeof(DrawElementsIndirectCommand));
}


for each object
{
    bind everything;
    draw one object;
}
